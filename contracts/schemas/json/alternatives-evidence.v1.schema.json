{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://unitesis.example.invalid/contracts/alternatives-evidence/1",
  "title": "UNITESIS conductor alternatives evidence (unitesis.alternatives-evidence/1)",
  "required": [
    "schema",
    "source_manifest",
    "line_id",
    "snapshot_sha256",
    "catalog",
    "criteria",
    "economic_basis",
    "engine",
    "alternatives",
    "ranking",
    "recommended",
    "status",
    "technical_acceptance",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "unitesis.alternatives-evidence/1"
    },
    "source_manifest": {
      "type": "object",
      "required": [
        "source_id",
        "source_sha256",
        "snapshot_sha256"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "line_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog": {
      "type": "object",
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "economic_basis": {
      "type": "object",
      "required": [
        "currency",
        "base_year",
        "discount_rate",
        "horizon_years",
        "energy_price_per_mwh",
        "loss_load_factor",
        "source",
        "basis_sha256"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "basis_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "screen",
          "technical_feasible",
          "independent_check"
        ],
        "properties": {
          "technical_feasible": {
            "type": "boolean"
          },
          "independent_check": {
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "not_run"
            ]
          }
        }
      }
    },
    "ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "alternative_id",
          "npv_total_cost",
          "status"
        ],
        "properties": {
          "npv_total_cost": {
            "type": "number"
          },
          "status": {
            "const": "engineering_screening_only"
          }
        }
      }
    },
    "recommended": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "const": "proposal_requires_human_review"
    },
    "technical_acceptance": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
